# Copy to .env (never committed).
PORT=8020
DATABASE_PATH=dist/database.sqlite 

# HTTPS (set USE_HTTPS=1 and provide key/cert paths)
# USE_HTTPS=0
# SSL_KEY_PATH=/path/to/privkey.pem
# SSL_CERT_PATH=/path/to/fullchain.pem


# Logs (see server/logger.ts). Levels: debug, info, warn, error, critical, off.
# LOG_FILE=dist/logs.log        # "off" to disable the file
# LOG_CONSOLE=1                 # 0 to stop printing logs on stdout/stderr
# LOG_LEVEL=info                # default level of every category
# Per category (overrides LOG_LEVEL):
# LOG_LEVEL_SERVER=info         # start-up, shutdown, crashes
# LOG_LEVEL_HTTP=info           # one line per request (debug: /api/health too)
# LOG_LEVEL_API=info            # meetings booked, updated, validated, canceled
# LOG_LEVEL_AUTH=info           # logins, failed logins, sessions, denied access
# LOG_LEVEL_DATABASE=info       # opening, migrations (debug: rolled back transactions)
# LOG_LEVEL_USERSCRIPT=info     # agent scripts: dispatch, runs, sandbox (debug: process details)
# LOG_LEVEL_SEED=info           # npm run seed
